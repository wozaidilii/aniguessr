  "font": {
    "family": {
      "heading": "\"Sora\", \"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic UI\", \"Meiryo\", sans-serif",
      "body": "\"Noto Sans JP\", \"Hiragino Sans\", \"Yu Gothic UI\", \"Meiryo\", system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Noto Sans Mono CJK JP\", monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "scale": {
      "display": {
        "size": "56px",
        "sizeMobile": "34px",
        "lineHeight": 1.35,
        "weight": 700,
        "letterSpacing": "0"
      },
      "h1": {
        "size": "40px",
        "sizeMobile": "28px",
        "lineHeight": 1.4,
        "weight": 700,
        "letterSpacing": "0"
      },
      "h2": {
        "size": "32px",
        "sizeMobile": "24px",
        "lineHeight": 1.45,
        "weight": 700,
        "letterSpacing": "0"
      },
      "h3": {
        "size": "22px",
        "sizeMobile": "20px",
        "lineHeight": 1.5,
        "weight": 700,
        "letterSpacing": "0"
      },
      "lead": {
        "size": "18px",
        "sizeMobile": "16px",
        "lineHeight": 1.8,
        "weight": 400,
        "letterSpacing": "0.02em"
      },
      "body": {
        "size": "16px",
        "sizeMobile": "15px",
        "lineHeight": 1.75,
        "weight": 400,
        "letterSpacing": "0.02em"
      },
      "small": {
        "size": "14px",
        "sizeMobile": "14px",
        "lineHeight": 1.7,
        "weight": 400,
        "letterSpacing": "0.02em"
      },
      "caption": {
        "size": "12px",
        "sizeMobile": "12px",
        "lineHeight": 1.6,
        "weight": 500,
        "letterSpacing": "0.04em"
      },
      "eyebrow": {
        "size": "12px",
        "sizeMobile": "12px",
        "lineHeight": 1.5,
        "weight": 700,
        "letterSpacing": "0.12em"
      }
    },
    "rules": {
      "headings": "font-feature-settings: 'palt'; word-break: auto-phrase; text-wrap: balance; text-autospace: normal; no negative letter-spacing on Japanese; key headings: BudouX <wbr> + word-break: keep-all",
      "body": "line-break: strict; overflow-wrap: anywhere; text-autospace: normal (progressive)",
      "copy": "Do not type half-width spaces between Japanese and Latin/digits (they become line-break opportunities); spacing comes from text-autospace"
    }
  },
